# =============================================================================
# Amazon Connect + ElevenLabs Integration Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- ElevenLabs Configuration ---
# Your ElevenLabs API key (from https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs voice ID for TTS (from https://elevenlabs.io/app/voice-library)
# Example premade voices:
#   Rachel: 21m00Tcm4TlvDq8ikWAM
#   Domi:   AZnzlk1XvdvUeBnXmlld
#   Bella:  EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs model ID for TTS
# Options: eleven_multilingual_v2, eleven_flash_v2_5, eleven_turbo_v2_5
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ElevenLabs Conversational AI Agent ID (for Approach 2)
# Create at https://elevenlabs.io/app/conversational-ai
ELEVENLABS_AGENT_ID=

# Name of an existing Secrets Manager secret containing the ElevenLabs API key.
# If set, the stack imports this secret instead of creating a new one.
# Leave blank to have the stack create a new secret using ELEVENLABS_API_KEY.
ELEVENLABS_SECRET_NAME=

# --- Amazon Connect Configuration ---
# Set to "true" to create a new Connect instance, "false" to use existing
CREATE_NEW_CONNECT_INSTANCE=false

# If using an existing instance, provide its ARN
# Format: arn:aws:connect:<region>:<account>:instance/<instance-id>
CONNECT_INSTANCE_ARN=

# If creating a new instance, provide an alias (unique name)
CONNECT_INSTANCE_ALIAS=my-elevenlabs-connect

# --- AWS Configuration ---
# AWS region for deployment
AWS_REGION=us-east-1

# --- Feature Flags ---
# Deploy the WebSocket bridge Lambda for Conversational AI agent integration
DEPLOY_AGENT_BRIDGE=true
